        <mxCell id="F8tB9rZM36C0WDxNQP6x-12" value="Win11&amp;nbsp;&lt;div&gt;VM&lt;/div&gt;" style="image;sketch=0;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/mscae/VirtualMachineWindows.svg;" parent="1" vertex="1">
