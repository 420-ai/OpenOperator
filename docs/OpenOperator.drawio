        <mxCell id="gD-qwYipdkoxbAM_ASpI-6" value="Agent" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="3204" y="1160" width="55" height="55" as="geometry" />
