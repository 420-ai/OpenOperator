        </mxCell>
        <mxCell id="F8tB9rZM36C0WDxNQP6x-16" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Actions&lt;/h1&gt;&lt;div&gt;&lt;b&gt;Keyboard, Mouse&lt;/b&gt;&lt;/div&gt;&lt;div&gt;PyAutoGUI -&amp;nbsp;https://github.com/asweigart/pyautogui/&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CDP&lt;/b&gt;&lt;/div&gt;&lt;div&gt;PyCDP -&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;https://py-cdp.readthedocs.io/en/latest/&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
