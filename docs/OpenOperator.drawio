        <mxCell id="oaTdhb-5ZbjvPPa2fwc--39" value="&lt;div&gt;&lt;div&gt;&lt;b&gt;=== SYSTEM_MESSAGE ===&lt;/b&gt;&lt;br&gt;You are AI agent responsible for deciding, if the step is already done, based on the screenshot.&lt;br&gt;&lt;br&gt;Output:&lt;br&gt;Return &quot;TRUE&quot; if the step is already done or can be skipped.&lt;/div&gt;&lt;/div&gt;&lt;div&gt;Return &quot;FALSE&quot; if the step we can proceed with the step&lt;/div&gt;" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#36393d;strokeWidth=1;fillColor=#eeeeee;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" parent="1" vertex="1">
