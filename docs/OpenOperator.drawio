        <mxCell id="F8tB9rZM36C0WDxNQP6x-15" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Observations&lt;/h1&gt;&lt;div&gt;&lt;b&gt;a11y&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Pyatspi -&amp;nbsp;https://github.com/GNOME/pyatspi2&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;SoM&lt;/b&gt;&lt;/div&gt;&lt;div&gt;SoM -&amp;nbsp;https://github.com/microsoft/SoM&lt;/div&gt;&lt;div&gt;Omniparser -&amp;nbsp;https://github.com/microsoft/OmniParser&lt;br&gt;Optical character recognition (OCR) -&amp;nbsp;pytesseract&lt;/div&gt;&lt;div&gt;GroundingDINO -&amp;nbsp;https://github.com/IDEA-Research/GroundingDINO&lt;/div&gt;&lt;div&gt;Webparse&lt;br&gt;&lt;br&gt;&lt;b&gt;Processes&lt;/b&gt;&lt;br&gt;Pywin32 -&amp;nbsp;https://github.com/mhammond/pywin32&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;ETW&lt;/b&gt;&lt;/div&gt;&lt;div&gt;pywintrace -&amp;nbsp;https://github.com/fireeye/pywintrace&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
