{
  "instruction": "Find a list of chats inside Microsoft Teams. Switch between the chats 2 times. Summarize the latest chat thread in 3 paragraphs with bullet points. Reply with that information to the results.",
  "workflow": {
    "params": {
      "max_plan_versions": 20,
      "max_plan_step_iterations": 3,
      "max_plan_step_actions": 5
    }
  },
  "environment": {
    "start": [
      {
        "func": "close_all_windows",
        "args": null
      },
      {
        "func": "delete_files",
        "args": {
          "paths": ["/data/logs/teams-telemetry/teams-telemetry-0.log"]
        }
      },
      {
        "func": "start_network_proxy",
        "args": null
      },
      {
        "func": "open_application",
        "args": {
          "app_name": "Microsoft Teams"
        }
      }
    ],
    "end": [
      {
        "func": "stop_network_proxy",
        "args": null
      },
      {
        "func": "close_all_windows",
        "args": null
      },
      {
        "func": "get_evaluation_results",
        "args": {
          "evaluation": [
            {
              "evaluator": "teams_scenarios",
              "scenarios": ["chat_switch"],
              "telemetry_file": "/data/logs/teams-telemetry/teams-telemetry-0.log"
            }
          ]
        }
      }
    ]
  }
}
