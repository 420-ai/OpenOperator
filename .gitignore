.DS_Store
.gradio
.venv
__pycache__
*.egg-info

dist
**/node_modules

# Ignore OS generated files
Zone.Identifier

# Ignore all .env files
.env
!servers/server_browser_control/.env
!servers/server_computer_control/.env
!servers/server_network_proxy/.env
!servers/server_evaluator/.env
!servers/server_omniparser/.env
!servers/mcp_server_computer_control/.env
!computers/windows/docker/data/init/.env
!computers/windows/parallels_vm/data/init/.env

# Ignore all logs
logs
*.log

# Computers
!computers/windows/docker/data/logs
computers/windows/docker/data/logs/*.txt
computers/windows/docker/data/server_browser_control
computers/windows/docker/data/server_computer_control
computers/windows/docker/data/mcp_server_computer_control
computers/windows/docker/data/server_evaluator
computers/windows/docker/data/server_network_proxy
!computers/windows/parallels_vm/data/logs
computers/windows/parallels_vm/data/server_browser_control
computers/windows/parallels_vm/data/server_computer_control
computers/windows/parallels_vm/data/server_evaluator
computers/windows/parallels_vm/data/server_network_proxy
computers/**/iso
computers/**/storage
computers/**/storage*

# Servers
servers/**/recordings
servers/**/traces
servers/**/parsed
servers/**/screenshots
servers/**/user_data
servers/**/weights

# Agents
agents/**/recordings
agents/**/traces
agents/**/screenshots
agents/**/tracker
agents/**/parsed
agents/**/results
agents/**/test
agents/**/tmp
agents/**/state
agents/**/logs
agents/**/cache

old_agents/**/recordings
old_agents/**/traces
old_agents/**/screenshots
old_agents/**/tracker
old_agents/**/parsed
old_agents/**/results
old_agents/**/test
old_agents/**/tmp
old_agents/**/state
old_agents/**/logs
old_agents/**/cache

# Core
!agents/test
!agents/core/test
agents/core/test/**/out

# Models
models/magma/video/*.png

# UI
**/ui/**/recordings/

# Terraform specific files --

# Local .terraform directory
**/.terraform/

# Terraform plan and state
**/*.tfstate
**/*.tfstate.backup
**/*.tfplan
**/*.tfapply
**/.terraform.tfstate.lock.info

# Crash logs
**/crash.log


