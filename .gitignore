.DS_Store
.gradio
.venv
__pycache__

dist
**/node_modules

# Ignore OS generated files
Zone.Identifier

# Ignore all .env files
.env
!servers/server_browser_control/.env
!servers/server_computer_control/.env
!computers/windows/docker/data/init/.env
!computers/windows/parallels_vm/data/init/.env

# Ignore all logs
logs
*.log

# Computers
!computers/windows/docker/data/logs
computers/windows/docker/data/logs/*.txt
computers/windows/docker/data/server_browser_control
computers/windows/docker/data/server_computer_control
!computers/windows/parallels_vm/data/logs
computers/windows/parallels_vm/data/server_browser_control
computers/windows/parallels_vm/data/server_computer_control
computers/**/iso
computers/**/storage

# Servers
servers/**/recordings
servers/**/traces
servers/**/screenshots
servers/**/user_data
servers/**/weights

# Agents
agents/**/recordings
agents/**/traces
agents/**/screenshots
agents/**/tracker
agents/**/parsed
agents/**/results
agents/**/test
agents/**/tmp
agents/**/state
agents/**/logs
agents/**/cache

# Models
models/magma/video/*.png

# UI
**/ui/**/recordings/
